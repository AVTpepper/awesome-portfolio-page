rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "qDhk396226ecKLG2ZGTHVvoKta83";
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "qDhk396226ecKLG2ZGTHVvoKta83";
    }
    match /services/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "qDhk396226ecKLG2ZGTHVvoKta83";
    }
    match /settings/site {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "qDhk396226ecKLG2ZGTHVvoKta83";
    }
    match /contact-submissions/{id} {
      allow create: if false;
      allow read, update, delete: if request.auth != null && request.auth.uid == "qDhk396226ecKLG2ZGTHVvoKta83";
    }
  }
}
