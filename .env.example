# Firebase client SDK (public — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — never expose to the browser)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key as a single line with \n for newlines
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend (server-only)
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=

# Public contact email shown in the UI (optional — omit to hide the mailto fallback)
NEXT_PUBLIC_CONTACT_EMAIL=

# Base URL for sitemap, robots, and OG metadata
NEXT_PUBLIC_BASE_URL=https://your-project.web.app
